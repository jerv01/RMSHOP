# ---------------------------------------------------------------------------
# Backend de RM Shop (Django). Copia este archivo a `.env` y ajusta los valores.
# El archivo `.env` real nunca se sube a git.
# ---------------------------------------------------------------------------

# Clave secreta de Django. En desarrollo sirve cualquier texto; en producción debe ser larga
# y aleatoria (python -c "import secrets; print(secrets.token_urlsafe(50))").
DJANGO_SECRET_KEY=change-me-solo-desarrollo

# Modo depuración. True solo en desarrollo.
DJANGO_DEBUG=True

# Hosts desde los que se acepta tráfico, separados por comas. `backend` es el nombre del
# servicio dentro de Docker Compose.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Conexión a PostgreSQL. `db` es el servicio de Docker Compose; el usuario, la contraseña y la
# base coinciden con los valores por defecto del docker-compose.yml.
DATABASE_URL=postgres://rmshop:rmshop@db:5432/rmshop

# Origen(es) del frontend autorizados por CORS, separados por comas.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Orígenes de confianza para CSRF (hoy sin efecto: la API no usa cookies ni CSRF).
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Clerk (https://dashboard.clerk.com). Guía paso a paso: docs/clerk-setup.md
# Clave secreta de la instancia: Configure > API keys > Secret keys (empieza por sk_test_).
CLERK_SECRET_KEY=
# Secreto de firma del webhook: Configure > Webhooks > tu endpoint > Signing Secret (whsec_...).
# Opcional en el sprint 1: solo se necesita para probar webhooks con un túnel público.
CLERK_WEBHOOK_SECRET=
# Orígenes del frontend permitidos en el claim `azp` del token, separados por comas.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
# Opcional: clave pública PEM (API keys > Show JWT public key > PEM Public Key). Si se define,
# el token se verifica sin llamar a Clerk (más rápido y funciona sin red).
CLERK_JWT_KEY=

# Correo. En local se envía a Mailpit (interfaz web en http://localhost:8025).
EMAIL_HOST=mailpit
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=RM Shop <no-reply@rmshop.local>
