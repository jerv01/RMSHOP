# ---------------------------------------------------------------------------
# Frontend de RM Shop (Vite + React). Copia este archivo a `.env` y ajusta los valores.
# El archivo `.env` real nunca se sube a git. Las variables VITE_* son públicas: se incluyen
# en el código que descarga el navegador, así que aquí nunca van secretos.
# ---------------------------------------------------------------------------

# URL de la API de Django, vista desde el navegador (no desde Docker).
VITE_API_URL=http://localhost:8000

# Clave publicable de Clerk: Configure > API keys > Publishable key (empieza por pk_test_).
# Guía paso a paso: docs/clerk-setup.md. Sin ella la app muestra una pantalla de configuración.
VITE_CLERK_PUBLISHABLE_KEY=

# Pon true si el hot reload no detecta cambios (Docker en Windows o macOS).
WATCH_POLLING=false
