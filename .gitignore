# Entornos y secretos (solo se versionan los .env.example)
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# Node
node_modules/
.pnpm-store/
dist/
*.tsbuildinfo
coverage/
.vite/

# Editores y sistema operativo
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Estáticos generados por collectstatic
apps/backend/staticfiles/*
!apps/backend/staticfiles/.gitkeep

# Medios subidos localmente
apps/backend/media/*
!apps/backend/media/.gitkeep

