# ---------------------------------------------------------------------------
# Variables opcionales de Docker Compose. Todas tienen un valor por defecto en
# docker-compose.yml, así que este archivo (copiado a `.env` en la raíz) solo hace falta
# si quieres cambiar algo.
# ---------------------------------------------------------------------------

# Imagen de PostgreSQL. Debe tener la misma versión mayor que Supabase (17).
POSTGRES_VERSION=17.11-alpine

# Credenciales de la base local. Si las cambias, actualiza también DATABASE_URL en
# apps/backend/.env y borra el volumen (docker compose down -v) para recrear la base.
POSTGRES_USER=rmshop
POSTGRES_PASSWORD=rmshop
POSTGRES_DB=rmshop

# Puerto de tu máquina para PostgreSQL. Cámbialo (por ejemplo a 5433) si el 5432 está ocupado.
DB_HOST_PORT=5432
